[Unit]
Description=AI Server Performance Monitor (Root)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/xchgeaxeax/.hermes/workspace/monitor/server.py
WorkingDirectory=/home/xchgeaxeax/.hermes/workspace/monitor
Restart=on-failure
RestartSec=5
User=root
# Memory limit (sampler threads keep a small cache; API is on-demand)
MemoryMax=256M
LimitNOFILE=2048
# Caddy reverse-proxies https://monitor.mtf.homes:9000 -> localhost:9527
Environment=AI_MONITOR_PORT=9527
Environment=AI_MONITOR_HOST=127.0.0.1
Environment=AI_MONITOR_DEBUG=0

[Install]
WantedBy=multi-user.target
